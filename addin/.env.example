# Local development settings. Copy this file to addin/.env (ignored by Git) and fill in your values.
# Production builds (GitHub Actions) read the same names from repository variables instead.

# Entra ID app registration > Overview > Application (client) ID
AUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Entra ID app registration > Overview > Directory (tenant) ID
AUTH_TENANT_ID=00000000-0000-0000-0000-000000000000

# SharePoint site that holds the templates library
SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/EmailTemplates

# Display name of the document library (default: Email Templates). The site's default library is "Documents"
# (its URL name "Shared Documents" also works).
SHAREPOINT_LIBRARY=Email Templates

# Optional folder inside the library, for example Email or Email/HR. Subfolders are included.
# Leave empty to use the whole library.
SHAREPOINT_FOLDER=
